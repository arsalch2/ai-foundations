# Pick one: ollama (free, local) | openai | azure
LLM_PROVIDER=ollama
CHAT_MODEL=llama3.2

# --- OpenAI ---
# LLM_PROVIDER=openai
# CHAT_MODEL=<a small, cheap model from OpenAI's model list>
# OPENAI_API_KEY=sk-...

# --- Azure OpenAI ---  (CHAT_MODEL = your deployment name)
# LLM_PROVIDER=azure
# CHAT_MODEL=my-gpt-deployment
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_API_VERSION=        # leave empty for the v1 endpoint

# --- Ollama ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
